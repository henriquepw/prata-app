{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "preset": "recommended",
        "organizeImports": "on",
        "useSortedProperties": "on"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noUselessContinue": "warn"
      },
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": {
          "level": "warn",
          "options": {
            "ignoreRestSiblings": true
          }
        },
        "noReactNativeRawText": {
          "level": "error",
          "options": {
            "skip": [
              "ButtonText",
              "CardTitle",
              "Heading",
              "Link",
              "Point",
              "form.SubmitButton",
              "signUpform.SubmitButton"
            ]
          }
        }
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "warn"
        }
      },
      "performance": {
        "preset": "recommended"
      },
      "style": {
        "noInferrableTypes": "error",
        "noParameterAssign": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useImportType": "warn",
        "useNumberNamespace": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noThenProperty": "off"
      }
    }
  },
  "tailwind": {
    "mergeFunctions": ["cn"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
